#!/usr/bin/env python3
"""Serve 3D models (obj/ply/stl/glb/gltf) in a browser viewer over an SSH tunnel.

usage: objview [-p PORT] FILE_OR_DIR...

Binds to 127.0.0.1 only and puts a random token in the URL, since login nodes
are shared. Run the printed `objtunnel` command on the laptop to open it.
"""
import argparse
import json
import mimetypes
import os
import secrets
import shutil
import socket
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import quote, unquote

EXTS = (".obj", ".ply", ".stl", ".glb", ".gltf")


def collect(paths):
    """Return (roots, models): served directories and the models inside them."""
    roots, models = [], []
    for p in paths:
        p = os.path.abspath(p)
        if os.path.isdir(p):
            files = sorted(f for f in os.listdir(p) if f.lower().endswith(EXTS))
            root = p
        elif os.path.isfile(p):
            files = [os.path.basename(p)]
            root = os.path.dirname(p)
        else:
            sys.exit(f"objview: no such file or directory: {p}")
        if root not in roots:
            roots.append(root)
        idx = roots.index(root)
        for f in files:
            models.append({
                "name": f,
                "url": f"f/{idx}/{quote(f)}",
                "mtl": mtllib(os.path.join(root, f)),
                "size": os.path.getsize(os.path.join(root, f)),
            })
    if not models:
        sys.exit("objview: no supported models found (" + " ".join(EXTS) + ")")
    return roots, models


def mtllib(path):
    """Find the material file an obj references, if it sits next to it."""
    if not path.lower().endswith(".obj"):
        return None
    with open(path, "rb") as fh:
        head = fh.read(256 * 1024).decode("utf-8", "ignore")
    for line in head.splitlines():
        if line.startswith("mtllib "):
            name = line[7:].strip()
            if os.path.isfile(os.path.join(os.path.dirname(path), name)):
                return name
    return None


def make_handler(token, roots, page):
    prefix = f"/{token}/"

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            path = unquote(self.path.split("?", 1)[0])
            if path == prefix.rstrip("/"):
                self.send_response(301)
                self.send_header("Location", prefix)
                self.end_headers()
            elif path == prefix:
                self.send(page.encode(), "text/html; charset=utf-8")
            elif path.startswith(prefix + "f/"):
                self.send_file(path[len(prefix) + 2:])
            else:
                self.send_error(404)

        def send(self, body, ctype):
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def send_file(self, rest):
            idx, _, rel = rest.partition("/")
            if not idx.isdigit() or int(idx) >= len(roots):
                return self.send_error(404)
            root = roots[int(idx)]
            full = os.path.realpath(os.path.join(root, rel))
            if not full.startswith(os.path.realpath(root) + os.sep) or not os.path.isfile(full):
                return self.send_error(404)
            self.send_response(200)
            self.send_header("Content-Type", mimetypes.guess_type(full)[0] or "application/octet-stream")
            self.send_header("Content-Length", str(os.path.getsize(full)))
            self.end_headers()
            try:
                with open(full, "rb") as fh:
                    shutil.copyfileobj(fh, self.wfile, 1024 * 1024)
            except (BrokenPipeError, ConnectionResetError):
                pass

    return Handler


def main():
    parser = argparse.ArgumentParser(description="View 3D models in the browser over an SSH tunnel.")
    parser.add_argument("paths", nargs="+", help="model files or directories containing them")
    parser.add_argument("-p", "--port", type=int, default=0, help="port to serve on (default: random free port)")
    args = parser.parse_args()

    roots, models = collect(args.paths)
    token = secrets.token_urlsafe(9)
    page = PAGE.replace("__MODELS__", json.dumps(models))

    try:
        server = ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(token, roots, page))
    except OSError as e:
        sys.exit(f"objview: cannot bind port {args.port}: {e.strerror}")
    port = server.server_address[1]
    node = socket.gethostname().split(".")[0]

    print(f"objview: serving {len(models)} model(s) on {node}:{port}")
    print(f"  laptop:  objtunnel {node} {port}/{token}")
    print(f"  url:     http://localhost:{port}/{token}/")
    print("  Ctrl-C to stop", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print()


PAGE = r"""<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>objview</title>
<style>
  :root { --bg: #1e1e2e; --panel: #181825ee; --fg: #cdd6f4; --dim: #7f849c; --accent: #89b4fa; }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--fg);
    font: 13px/1.4 ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace; overflow: hidden; }
  #view { position: fixed; inset: 0; }
  .panel { position: fixed; background: var(--panel); border-radius: 6px; padding: 10px 12px; }
  #list { top: 12px; left: 12px; max-height: calc(100% - 24px); overflow: auto; min-width: 200px; }
  #list div { padding: 3px 6px; border-radius: 4px; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; }
  #list div:hover { background: #ffffff14; }
  #list div.on { color: var(--accent); }
  #list span { color: var(--dim); }
  #info { bottom: 12px; left: 12px; white-space: pre; }
  #keys { bottom: 12px; right: 12px; color: var(--dim); white-space: pre; }
  #status { top: 50%; left: 50%; transform: translate(-50%, -50%); display: none; }
</style>
<script type="importmap">
{ "imports": {
  "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
  "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
} }
</script>
</head>
<body>
<div id="view"></div>
<div id="list" class="panel"></div>
<div id="info" class="panel"></div>
<div id="keys" class="panel">f  fit view
w  wireframe
u  toggle z-up
g  grid
+/-  point size</div>
<div id="status" class="panel"></div>
<script type="module">
import * as THREE from "three";
import { OrbitControls } from "three/addons/controls/OrbitControls.js";
import { OBJLoader } from "three/addons/loaders/OBJLoader.js";
import { MTLLoader } from "three/addons/loaders/MTLLoader.js";
import { PLYLoader } from "three/addons/loaders/PLYLoader.js";
import { STLLoader } from "three/addons/loaders/STLLoader.js";
import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

const MODELS = __MODELS__;
const $ = (id) => document.getElementById(id);
const mb = (n) => (n / 1048576).toFixed(1) + " MB";

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(window.devicePixelRatio);
$("view").appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x1e1e2e);
scene.add(new THREE.HemisphereLight(0xffffff, 0x444455, 1.6));
const sun = new THREE.DirectionalLight(0xffffff, 1.4);
scene.add(sun);

const camera = new THREE.PerspectiveCamera(45, 1, 0.01, 1000);
camera.add(sun);
sun.position.set(1, 1, 2);
scene.add(camera);
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;

let grid = null;
let model = null;
let zUp = false;
let wire = false;
let pointSize = 1;

function resize() {
  renderer.setSize(innerWidth, innerHeight);
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
}
addEventListener("resize", resize);
resize();

function materials(fn) {
  model?.traverse((o) => o.material && [].concat(o.material).forEach(fn));
}

function fit() {
  if (!model) return;
  const box = new THREE.Box3().setFromObject(model);
  const size = box.getSize(new THREE.Vector3());
  const center = box.getCenter(new THREE.Vector3());
  const radius = size.length() / 2 || 1;
  const dist = (1.4 * radius) / Math.sin((camera.fov * Math.PI) / 360);
  camera.near = dist / 1000;
  camera.far = dist * 100;
  camera.updateProjectionMatrix();
  camera.position.copy(center).add(new THREE.Vector3(0.6, 0.45, 1).normalize().multiplyScalar(dist));
  controls.target.copy(center);
  controls.update();

  if (grid) scene.remove(grid);
  const span = Math.max(size.x, size.z) * 2 || 1;
  grid = new THREE.GridHelper(span, 20, 0x585b70, 0x313244);
  grid.position.set(center.x, box.min.y, center.z);
  scene.add(grid);

  const d = (v) => +v.toPrecision(4);
  let tris = 0, verts = 0;
  model.traverse((o) => {
    if (!o.geometry) return;
    const n = o.geometry.attributes.position.count;
    verts += n;
    if (o.isMesh) tris += (o.geometry.index ? o.geometry.index.count : n) / 3;
  });
  $("info").textContent =
    `${current.name}  (${mb(current.size)})\n` +
    `${verts.toLocaleString()} vertices` + (tris ? `, ${Math.round(tris).toLocaleString()} triangles` : ", point cloud") + "\n" +
    `size ${d(size.x)} x ${d(size.y)} x ${d(size.z)}`;
}

function prepare(obj, keepMaterials) {
  obj.traverse((o) => {
    if (!o.isMesh) return;
    const g = o.geometry;
    if (!g.attributes.normal) g.computeVertexNormals();
    if (!keepMaterials) {
      o.material = new THREE.MeshStandardMaterial({ color: 0xbac2de, roughness: 0.7, metalness: 0.05 });
    }
    [].concat(o.material).forEach((m) => {
      m.side = THREE.DoubleSide;
      if (g.attributes.color) m.vertexColors = true;
    });
  });
  return obj;
}

function fromPly(g) {
  if (g.index) return new THREE.Mesh(g);
  // ply without faces is a point cloud
  const colors = !!g.attributes.color;
  return new THREE.Points(g, new THREE.PointsMaterial({
    size: pointSize, sizeAttenuation: false, vertexColors: colors, color: colors ? 0xffffff : 0xbac2de,
  }));
}

let current = null;
async function load(m) {
  current = m;
  document.querySelectorAll("#list div").forEach((el) => el.classList.toggle("on", el.dataset.url === m.url));
  if (model) { scene.remove(model); model = null; }
  $("status").style.display = "block";
  const progress = (e) => { $("status").textContent = `loading ${m.name}  ${mb(e.loaded)} / ${mb(m.size)}`; };
  progress({ loaded: 0 });

  const ext = m.name.toLowerCase().split(".").pop();
  const base = m.url.slice(0, m.url.lastIndexOf("/") + 1);
  try {
    let obj;
    if (ext === "obj") {
      const loader = new OBJLoader();
      if (m.mtl) {
        const mtl = await new MTLLoader().setPath(base).loadAsync(m.mtl);
        mtl.preload();
        loader.setMaterials(mtl);
      }
      obj = await loader.loadAsync(m.url, progress);
    } else if (ext === "ply") {
      obj = fromPly(await new PLYLoader().loadAsync(m.url, progress));
    } else if (ext === "stl") {
      obj = new THREE.Mesh(await new STLLoader().loadAsync(m.url, progress));
    } else {
      obj = (await new GLTFLoader().loadAsync(m.url, progress)).scene;
    }
    model = new THREE.Group();
    model.add(prepare(obj, !!m.mtl || ext === "glb" || ext === "gltf"));
    model.rotation.x = zUp ? -Math.PI / 2 : 0;
    if (wire) materials((mat) => { mat.wireframe = true; });
    scene.add(model);
    $("status").style.display = "none";
    fit();
  } catch (err) {
    $("status").textContent = `failed to load ${m.name}: ${err.message || err}`;
  }
}

if (MODELS.length > 1) {
  for (const m of MODELS) {
    const el = document.createElement("div");
    el.dataset.url = m.url;
    el.innerHTML = `${m.name}<span>${mb(m.size)}</span>`;
    el.onclick = () => load(m);
    $("list").appendChild(el);
  }
} else {
  $("list").style.display = "none";
}

addEventListener("keydown", (e) => {
  if (e.key === "f") fit();
  if (e.key === "w") { wire = !wire; materials((m) => { m.wireframe = wire; }); }
  if (e.key === "u") { zUp = !zUp; if (model) { model.rotation.x = zUp ? -Math.PI / 2 : 0; fit(); } }
  if (e.key === "g" && grid) grid.visible = !grid.visible;
  if (e.key === "+" || e.key === "=" || e.key === "-") {
    pointSize = Math.max(1, pointSize + (e.key === "-" ? -1 : 1));
    materials((m) => { if (m.isPointsMaterial) m.size = pointSize; });
  }
});

renderer.setAnimationLoop(() => {
  controls.update();
  renderer.render(scene, camera);
});

load(MODELS[0]);
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
