<script type="module">
import * as THREE from "three";
import { OrbitControls } from "three/addons/controls/OrbitControls.js";
import { OBJLoader } from "three/addons/loaders/OBJLoader.js";
import { MTLLoader } from "three/addons/loaders/MTLLoader.js";
import { PLYLoader } from "three/addons/loaders/PLYLoader.js";
import { STLLoader } from "three/addons/loaders/STLLoader.js";
import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

const PLACES = __PLACES__;
const $ = (id) => document.getElementById(id);
const mb = (n) => (n / 1048576).toFixed(1) + " MB";
const raw = (p) => "raw" + p.split("/").map(encodeURIComponent).join("/");
const api = async (route, params) => {
  const r = await fetch(`api/${route}?` + new URLSearchParams(params));
  if (!r.ok) throw new Error(`${r.status} ${r.statusText}`);
  return r.json();
};

// ---------------------------------------------------------------- viewer

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(window.devicePixelRatio);
$("view").appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x1e1e2e);
scene.add(new THREE.HemisphereLight(0xffffff, 0x444455, 1.6));
const sun = new THREE.DirectionalLight(0xffffff, 1.4);
const camera = new THREE.PerspectiveCamera(45, 1, 0.01, 1000);
camera.add(sun);
sun.position.set(1, 1, 2);
scene.add(camera);
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;

let grid = null;
let model = null;
let current = null;
let zUp = false;
let wire = false;
let pointSize = 1;

function resize() {
  const { clientWidth: w, clientHeight: h } = $("main");
  renderer.setSize(w, h);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}
new ResizeObserver(resize).observe($("main"));

function materials(fn) {
  model?.traverse((o) => o.material && [].concat(o.material).forEach(fn));
}

function fit() {
  if (!model) return;
  const box = new THREE.Box3().setFromObject(model);
  const size = box.getSize(new THREE.Vector3());
  const center = box.getCenter(new THREE.Vector3());
  const radius = size.length() / 2 || 1;
  const dist = (1.4 * radius) / Math.sin((camera.fov * Math.PI) / 360);
  camera.near = dist / 1000;
  camera.far = dist * 100;
  camera.updateProjectionMatrix();
  camera.position.copy(center).add(new THREE.Vector3(0.6, 0.45, 1).normalize().multiplyScalar(dist));
  controls.target.copy(center);
  controls.update();

  const visible = grid ? grid.visible : true;
  if (grid) scene.remove(grid);
  const span = Math.max(size.x, size.z) * 2 || 1;
  grid = new THREE.GridHelper(span, 20, 0x585b70, 0x313244);
  grid.position.set(center.x, box.min.y, center.z);
  grid.visible = visible;
  scene.add(grid);

  const d = (v) => +v.toPrecision(4);
  let tris = 0, verts = 0;
  model.traverse((o) => {
    if (!o.geometry) return;
    const n = o.geometry.attributes.position.count;
    verts += n;
    if (o.isMesh) tris += (o.geometry.index ? o.geometry.index.count : n) / 3;
  });
  $("info").textContent =
    `${current.path.split("/").pop()}  (${mb(current.size)})\n` +
    `${verts.toLocaleString()} vertices` + (tris ? `, ${Math.round(tris).toLocaleString()} triangles` : ", point cloud") + "\n" +
    `size ${d(size.x)} x ${d(size.y)} x ${d(size.z)}`;
}

function prepare(obj, keepMaterials) {
  obj.traverse((o) => {
    if (!o.isMesh) return;
    const g = o.geometry;
    if (!g.attributes.normal) g.computeVertexNormals();
    if (!keepMaterials) {
      o.material = new THREE.MeshStandardMaterial({ color: 0xbac2de, roughness: 0.7, metalness: 0.05 });
    }
    [].concat(o.material).forEach((m) => {
      m.side = THREE.DoubleSide;
      if (g.attributes.color) m.vertexColors = true;
    });
  });
  return obj;
}

function fromPly(g) {
  if (g.index) return new THREE.Mesh(g);
  // ply without faces is a point cloud
  const colors = !!g.attributes.color;
  return new THREE.Points(g, new THREE.PointsMaterial({
    size: pointSize, sizeAttenuation: false, vertexColors: colors, color: colors ? 0xffffff : 0xbac2de,
  }));
}

let loading = 0;
async function load(path) {
  const id = ++loading;
  const name = path.split("/").pop();
  const ext = name.toLowerCase().split(".").pop();
  const url = raw(path);
  const base = url.slice(0, url.lastIndexOf("/") + 1);
  history.replaceState(null, "", "#" + path);
  document.title = `${name} - objview`;
  markCurrent(path);
  $("status").style.display = "block";
  $("status").textContent = `loading ${name}`;
  try {
    const info = await api("info", { path });
    const progress = (e) => {
      if (id === loading) $("status").textContent = `loading ${name}  ${mb(e.loaded)} / ${mb(info.size)}`;
    };
    let obj;
    if (ext === "obj") {
      const loader = new OBJLoader();
      if (info.mtl) {
        const mtl = await new MTLLoader().setPath(base).loadAsync(info.mtl);
        mtl.preload();
        loader.setMaterials(mtl);
      }
      obj = await loader.loadAsync(url, progress);
    } else if (ext === "ply") {
      obj = fromPly(await new PLYLoader().loadAsync(url, progress));
    } else if (ext === "stl") {
      obj = new THREE.Mesh(await new STLLoader().loadAsync(url, progress));
    } else {
      obj = (await new GLTFLoader().loadAsync(url, progress)).scene;
    }
    if (id !== loading) return;
    if (model) scene.remove(model);
    model = new THREE.Group();
    model.add(prepare(obj, !!info.mtl || ext === "glb" || ext === "gltf"));
    model.rotation.x = zUp ? -Math.PI / 2 : 0;
    if (wire) materials((m) => { m.wireframe = true; });
    scene.add(model);
    current = { path, size: info.size };
    $("status").style.display = "none";
    fit();
  } catch (err) {
    if (id === loading) $("status").textContent = `failed to load ${name}: ${err.message || err}`;
  }
}

// ---------------------------------------------------------------- browser

let dir = null;
let entries = [];

for (const p of PLACES) {
  const b = document.createElement("button");
  b.textContent = p.split("/").pop() || "/";
  b.title = p;
  b.onclick = () => browse(p);
  $("places").appendChild(b);
}

async function browse(d) {
  let ls;
  try {
    ls = await api("ls", { dir: d });
  } catch (err) {
    $("entries").innerHTML = `<div class="empty">cannot open ${d}: ${err.message}</div>`;
    return;
  }
  dir = ls.dir;
  entries = [
    ...(ls.parent ? [{ kind: "dir", name: "..", path: ls.parent }] : []),
    ...ls.dirs.map((n) => ({ kind: "dir", name: n + "/", path: `${dir === "/" ? "" : dir}/${n}` })),
    ...ls.files.map((f) => ({ kind: "file", name: f.name, size: f.size, path: `${dir === "/" ? "" : dir}/${f.name}` })),
  ];
  const parts = dir.split("/").filter(Boolean);
  $("crumbs").innerHTML = "";
  parts.forEach((p, i) => {
    const a = document.createElement("a");
    a.textContent = p;
    a.onclick = () => browse("/" + parts.slice(0, i + 1).join("/"));
    $("crumbs").append("/", a);
  });
  $("filter").value = "";
  render();
}

function render() {
  const f = $("filter").value.toLowerCase();
  const box = $("entries");
  box.innerHTML = "";
  const shown = entries.filter((e) => e.name === ".." || e.name.toLowerCase().includes(f));
  for (const e of shown) {
    const el = document.createElement("div");
    el.className = e.kind;
    el.dataset.path = e.path;
    el.innerHTML = `<span class="name"></span><span class="size">${e.size != null ? mb(e.size) : ""}</span>`;
    el.firstChild.textContent = e.name;
    el.onclick = () => (e.kind === "dir" ? browse(e.path) : load(e.path));
    box.appendChild(el);
  }
  if (!entries.some((e) => e.kind === "file")) {
    box.insertAdjacentHTML("beforeend", `<div class="empty">no models here</div>`);
  }
  markCurrent(location.hash.slice(1));
}

function markCurrent(path) {
  document.querySelectorAll("#entries div[data-path]").forEach((el) => el.classList.toggle("on", el.dataset.path === path));
}

$("filter").addEventListener("input", render);
$("filter").addEventListener("keydown", (e) => {
  if (e.key === "Escape") { $("filter").value = ""; render(); $("filter").blur(); }
  if (e.key === "Enter") document.querySelector("#entries div.file:not(.empty)")?.click();
});

// files sent with `objview` on the cluster
async function poll(seq) {
  for (;;) {
    try {
      const r = await api("events", { since: seq });
      seq = r.seq;
      for (const ev of r.events) {
        await browse(ev.dir);
        if (ev.files.length) load(ev.files[0]);
      }
    } catch {
      $("status").style.display = "block";
      $("status").textContent = "lost connection to the server, retrying...";
      await new Promise((r) => setTimeout(r, 3000));
      $("status").style.display = model ? "none" : "block";
    }
  }
}

addEventListener("keydown", (e) => {
  if (e.target.tagName === "INPUT") return;
  if (e.key === "/") { e.preventDefault(); $("filter").focus(); }
  if (e.key === "f") fit();
  if (e.key === "b") $("side").classList.toggle("hidden");
  if (e.key === "w") { wire = !wire; materials((m) => { m.wireframe = wire; }); }
  if (e.key === "u") { zUp = !zUp; if (model) { model.rotation.x = zUp ? -Math.PI / 2 : 0; fit(); } }
  if (e.key === "g" && grid) grid.visible = !grid.visible;
  if (e.key === "+" || e.key === "=" || e.key === "-") {
    pointSize = Math.max(1, pointSize + (e.key === "-" ? -1 : 1));
    materials((m) => { if (m.isPointsMaterial) m.size = pointSize; });
  }
});

renderer.setAnimationLoop(() => {
  controls.update();
  renderer.render(scene, camera);
});

// start where the URL points, else at the latest `objview` request, else in the first place
const start = decodeURIComponent(location.hash.slice(1));
api("last").then(({ seq, last }) => {
  if (start) {
    browse(start.slice(0, start.lastIndexOf("/")) || "/");
    load(start);
  } else if (last) {
    browse(last.dir);
    if (last.files.length) load(last.files[0]);
  } else {
    browse(PLACES[0]);
  }
  poll(seq);
});
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
