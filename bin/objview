#!/usr/bin/env python3
"""Browser 3D model viewer (obj/ply/stl/glb/gltf) for the cluster.

usage:
  objview [PATH...]   show files/folders in the open viewer tab (default: current folder)
  objview --url       start the server if needed and print "PORT TOKEN" (used by the laptop)
  objview --stop      stop the server

One server per user runs on SERVER_NODE, bound to 127.0.0.1 with a random token in
the URL since login nodes are shared. Requests are passed through a folder in $HOME,
so `objview` works from compute nodes too. On the laptop, `objview` opens the tab.
"""
import json
import mimetypes
import os
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote, unquote, urlsplit

SERVER_NODE = os.environ.get("OBJVIEW_NODE", "login07")  # the node `ssh gautschi` lands on
PORT = int(os.environ.get("OBJVIEW_PORT", 20000 + os.getuid() % 20000))
EXTS = (".obj", ".ply", ".stl", ".glb", ".gltf")
STATE = os.path.expanduser("~/.config/objview")
INBOX = os.path.join(STATE, "inbox")
HEARTBEAT = os.path.join(STATE, "heartbeat")
LOG = os.path.join(STATE, "server.log")
PLACES = [p for p in (
    os.path.expanduser("~"),
    f"/scratch/gautschi/{os.environ.get('USER', '')}",
    "/depot/ciampitti",
) if os.path.isdir(p)]


def token():
    path = os.path.join(STATE, "token")
    if not os.path.exists(path):
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.write(fd, secrets.token_urlsafe(12).encode())
        os.close(fd)
    with open(path) as fh:
        return fh.read().strip()


def node():
    return socket.gethostname().split(".")[0]


def server_alive():
    try:
        return time.time() - os.path.getmtime(HEARTBEAT) < 10
    except OSError:
        return False


def start_server():
    """Start the server in the background if it isn't running. Only possible on SERVER_NODE."""
    if server_alive():
        return True
    if node() != SERVER_NODE:
        return False
    os.makedirs(INBOX, exist_ok=True)
    with open(LOG, "ab") as log:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--serve"],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(50):
        if server_alive():
            return True
        time.sleep(0.1)
    sys.exit(f"objview: server failed to start, see {LOG}")


# ---------------------------------------------------------------- server

class Events:
    """Open requests, handed to the browser through long polling."""

    def __init__(self):
        self.items = []
        self.cond = threading.Condition()

    def add(self, req):
        with self.cond:
            self.items.append(req)
            self.cond.notify_all()

    def since(self, seq, timeout=25):
        with self.cond:
            self.cond.wait_for(lambda: len(self.items) > seq, timeout)
            return len(self.items), self.items[seq:]


def watch_inbox(events):
    beat = 0
    while True:
        if time.time() - beat > 3:
            with open(HEARTBEAT, "w") as fh:
                fh.write(f"{node()} {os.getpid()}\n")
            beat = time.time()
        for name in sorted(os.listdir(INBOX)):
            path = os.path.join(INBOX, name)
            try:
                with open(path) as fh:
                    req = json.load(fh)
                os.remove(path)
            except (OSError, ValueError):
                continue
            if time.time() - req.get("time", 0) < 600:
                events.add(req)
        time.sleep(0.3)


def mtllib(path):
    """Find the material file an obj references, if it sits next to it."""
    if not path.lower().endswith(".obj"):
        return None
    with open(path, "rb") as fh:
        head = fh.read(256 * 1024).decode("utf-8", "ignore")
    for line in head.splitlines():
        if line.startswith("mtllib "):
            name = line[7:].strip()
            if os.path.isfile(os.path.join(os.path.dirname(path), name)):
                return name
    return None


def listing(d):
    dirs, files = [], []
    with os.scandir(d) as it:
        for e in it:
            if e.name.startswith("."):
                continue
            try:
                if e.is_dir():
                    dirs.append(e.name)
                elif e.name.lower().endswith(EXTS):
                    files.append({"name": e.name, "size": e.stat().st_size})
            except OSError:
                pass
    dirs.sort(key=str.lower)
    files.sort(key=lambda f: f["name"].lower())
    return {"dir": d, "parent": os.path.dirname(d) if d != "/" else None, "dirs": dirs, "files": files}


def make_handler(tok, events, page):
    prefix = f"/{tok}"

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            url = urlsplit(self.path)
            path = unquote(url.path)
            q = {k: v[0] for k, v in parse_qs(url.query).items()}
            if not path.startswith(prefix):
                return self.send_error(404)
            route = path[len(prefix):]
            try:
                if route == "":
                    self.send_response(301)
                    self.send_header("Location", prefix + "/")
                    self.end_headers()
                elif route == "/":
                    self.send(page.encode(), "text/html; charset=utf-8")
                elif route == "/api/ping":
                    self.json({"ok": True})
                elif route == "/api/ls":
                    self.json(listing(os.path.abspath(q.get("dir", PLACES[0]))))
                elif route == "/api/info":
                    p = q["path"]
                    self.json({"size": os.path.getsize(p), "mtl": mtllib(p)})
                elif route == "/api/last":
                    with events.cond:
                        self.json({"seq": len(events.items), "last": events.items[-1] if events.items else None})
                elif route == "/api/events":
                    seq, items = events.since(int(q.get("since", 0)))
                    self.json({"seq": seq, "events": items})
                elif route.startswith("/raw/"):
                    self.send_file(route[4:])
                else:
                    self.send_error(404)
            except (FileNotFoundError, NotADirectoryError):
                self.send_error(404)
            except PermissionError:
                self.send_error(403)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def send(self, body, ctype):
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def json(self, obj):
            self.send(json.dumps(obj).encode(), "application/json")

        def send_file(self, path):
            if not os.path.isfile(path):
                return self.send_error(404)
            with open(path, "rb") as fh:
                self.send_response(200)
                self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
                self.send_header("Content-Length", str(os.fstat(fh.fileno()).st_size))
                self.end_headers()
                shutil.copyfileobj(fh, self.wfile, 1024 * 1024)

    return Handler


def serve():
    events = Events()
    os.makedirs(INBOX, exist_ok=True)
    page = PAGE.replace("__PLACES__", json.dumps(PLACES))
    server = ThreadingHTTPServer(("127.0.0.1", PORT), make_handler(token(), events, page))
    server.daemon_threads = True
    threading.Thread(target=watch_inbox, args=(events,), daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    print(f"{time.ctime()} serving on {node()}:{PORT} pid {os.getpid()}", flush=True)
    try:
        server.serve_forever()
    finally:
        os.remove(HEARTBEAT)


# ---------------------------------------------------------------- cli

def stop():
    try:
        with open(HEARTBEAT) as fh:
            host, pid = fh.read().split()
    except (OSError, ValueError):
        return print("objview: server not running")
    if host != node():
        sys.exit(f"objview: server runs on {host}, stop it from there")
    os.kill(int(pid), signal.SIGTERM)
    print("objview: stopped")


def send(paths):
    paths = [os.path.abspath(p) for p in paths]
    for p in paths:
        if not os.path.exists(p):
            sys.exit(f"objview: no such file or directory: {p}")
    files = [p for p in paths if os.path.isfile(p)]
    req = {"time": time.time(), "dir": os.path.dirname(files[0]) if files else paths[0], "files": files}

    os.makedirs(INBOX, exist_ok=True)
    tmp = os.path.join(INBOX, f".{os.getpid()}.tmp")
    with open(tmp, "w") as fh:
        json.dump(req, fh)
    os.rename(tmp, os.path.join(INBOX, f"{time.time():.6f}-{os.getpid()}.json"))

    what = os.path.basename(files[0]) if files else req["dir"]
    if start_server():
        print(f"objview: sent {what} to the viewer  http://localhost:{PORT}/{token()}/")
        print("  no tab open? run `objview` on your laptop")
    else:
        print(f"objview: queued {what}, but the server isn't running (it lives on {SERVER_NODE})")
        print("  run `objview` on your laptop to start it; the request is kept for 10 minutes")


def main():
    args = sys.argv[1:]
    if args == ["--serve"]:
        serve()
    elif args == ["--url"]:
        if not start_server():
            sys.exit(f"objview: start the server from {SERVER_NODE}")
        print(PORT, token())
    elif args == ["--stop"]:
        stop()
    elif args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
    else:
        send(args or ["."])


